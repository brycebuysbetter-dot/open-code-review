# --- core ---
BV_ENV=development                 # development | production
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET   # python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional: explicit Fernet key(s) instead of deriving one from APP_SECRET_KEY (comma-separate to rotate)
BV_ENCRYPTION_KEYS=
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_PUBLIC_HTTPS_API_DOMAIN
DOMAIN=jarvis.example.com          # used by the bundled Caddy for automatic HTTPS
BV_CORS_ORIGINS=https://jarvis.example.com
OWNER_NAME=Bryce                   # how Jarvis addresses you

# --- PostgreSQL ---
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# --- Texas / Central time ---
APP_TIMEZONE=America/Chicago
QUIET_HOURS_START=20:00            # no contact from 8pm...
QUIET_HOURS_END=09:00              # ...until 9am Central (recipient's local time is used per property state)
BV_CONTACT_DAYS=0,1,2,3,4,5        # 0=Mon .. 6=Sun (Sunday off)

# --- limits ---
RATE_LIMIT_PER_MINUTE=60
BV_MAX_SMS_PER_DAY=200
BV_MAX_SMS_PER_LEAD_PER_DAY=2
VOICE_MAX_DURATION_SECONDS=600

# --- automation: KEEP OFF DURING TESTING (approved items are held, not sent) ---
AUTOMATIC_MESSAGING_ENABLED=false
AUTOMATIC_VOICE_ENABLED=false
BV_REQUIRE_CONSENT=                # blank = required in production; true/false to force

# --- Anthropic ---
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Twilio (SMS + voice) ---
TWILIO_ACCOUNT_SID=AC_REPLACE
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1REPLACE

# --- Google (Gmail + Calendar) ---
BV_GOOGLE_CLIENT_ID=
BV_GOOGLE_CLIENT_SECRET=
BV_GOOGLE_REFRESH_TOKEN=
BV_GOOGLE_CALENDAR_ID=primary
BV_BUSINESS_EMAIL=
BV_BUSINESS_NAME=Bravo Vision
BV_BUSINESS_ADDRESS=

# --- Bravo Vision sync (see README) ---
BV_CRM_PROVIDER=bravo              # local | hubspot | bravo
BV_BRAVO_BASE_URL=https://REPLACE_WITH_YOUR_BRAVO_VISION_URL
BV_BRAVO_API_KEY=
BV_BRAVO_SYNC_KEY=                 # shared secret both apps use to authenticate/sign sync traffic
BV_WEBFORM_KEY=
BV_HUBSPOT_TOKEN=
